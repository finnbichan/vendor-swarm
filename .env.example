# Copy to .env. Every group is optional locally - leave it blank and that part runs in mock mode.
# In production (NODE_ENV=production) SWARM_API_KEY, ADMIN_SESSION_SECRET and real admin
# logins are required; the host refuses to start without them.

# --- Models: any OpenAI-compatible provider -------------------------------------------
# Vendors pick a provider + model on /admin (or "llm" in vendor.json); keys stay here.
# A vendor whose provider has no key uses the scripted negotiator.
LLM_PROVIDER=xai
XAI_API_KEY=
XAI_MODEL=grok-4.7
# XAI_BASE_URL=https://api.x.ai/v1
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
# Operator-defined endpoint, selectable as provider "custom" (vLLM, Ollama gateway, ...)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Per-call timeout, whole-turn budget before falling back to the script, parallel calls per provider
LLM_TIMEOUT_MS=15000
TURN_BUDGET_MS=25000
LLM_CONCURRENCY=4

# --- Live competitor prices. Blank = mock prices from each catalog.json ------------------
TAVILY_API_KEY=

# --- Swarm access -------------------------------------------------------------------------
# Bearer token the auctioneer (~/haggle, mini-auction) must send to /quote and /award.
SWARM_API_KEY=
# Comma-separated browser origins allowed to call the bots (default *), e.g. https://haggle.vercel.app
CORS_ORIGINS=
# Public base URL (the host uses RENDER_EXTERNAL_URL automatically on Render)
PUBLIC_URL=

# --- Supabase -----------------------------------------------------------------------------
# URL + anon key: owner login on /admin (Supabase Auth). URL + service-role key: config
# storage in the vendor_config table (run supabase/migrations/001_vendor_config.sql first).
# Without them: local passwords and vendors/*.json on disk.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only (bots + scripts). Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Force file storage even when Supabase is configured: CONFIG_STORAGE=file
ADMIN_EMAIL_DOMAIN=haggle.dev
# Signs local-mode admin sessions. Blank = random per boot (sessions end on restart).
ADMIN_SESSION_SECRET=
# Local-mode passwords (default haggle-<id>, refused in production):
# AURORA_ADMIN_PASSWORD=

# --- One Shopify dev store per vendor (custom app Admin API token). Blank = mock checkout --
SHOPIFY_API_VERSION=2025-07
AURORA_SHOPIFY_DOMAIN=
AURORA_SHOPIFY_TOKEN=
SOUNDHAUS_SHOPIFY_DOMAIN=
SOUNDHAUS_SHOPIFY_TOKEN=
NORTHLINE_SHOPIFY_DOMAIN=
NORTHLINE_SHOPIFY_TOKEN=
STRIDE_SHOPIFY_DOMAIN=
STRIDE_SHOPIFY_TOKEN=
CREMA_SHOPIFY_DOMAIN=
CREMA_SHOPIFY_TOKEN=
BYTEBAZAAR_SHOPIFY_DOMAIN=
BYTEBAZAAR_SHOPIFY_TOKEN=
PEAK_SHOPIFY_DOMAIN=
PEAK_SHOPIFY_TOKEN=
MEGAMART_SHOPIFY_DOMAIN=
MEGAMART_SHOPIFY_TOKEN=
